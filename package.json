{
  "name": "memebot",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "yakumo build",
    "check:plugin-artifacts": "node scripts/check-plugin-artifacts.cjs",
    "check:plugin-loads": "node scripts/check-plugin-loads.cjs",
    "smoke:local-app": "node scripts/smoke-local-app.cjs",
    "test": "vitest run",
    "typecheck": "yakumo typecheck && tsc -p tsconfig.tests.json --pretty false"
  },
  "devDependencies": {
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@koishijs/plugin-mock": "^2.6.6",
    "esbuild": "^0.25.8",
    "koishi": "^4.18.7",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4",
    "yakumo": "^1.0.0",
    "yakumo-esbuild": "^1.0.0",
    "yakumo-tsc": "^1.0.0"
  }
}
