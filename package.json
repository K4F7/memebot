{
  "name": "memebot",
  "private": true,
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev run build",
    "check:plugin-loads": "node scripts/check-plugin-loads.cjs",
    "smoke:archive-staging": "node scripts/archive-staging-smoke.cjs",
    "smoke:local-app": "node scripts/smoke-local-app.cjs",
    "test": "vitest run",
    "typecheck": "yarn workspaces foreach --all --topological-dev run typecheck && tsc -p tsconfig.tests.json --pretty false"
  },
  "devDependencies": {
    "@koishijs/plugin-database-memory": "^3.7.0",
    "@koishijs/plugin-mock": "^2.6.6",
    "koishi": "^4.18.7",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  }
}
