    "test:browser": "playwright test -c playwright.config.ts"
  },
  "peerDependencies": {
    "koishi": "^4.18.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "koishi-plugin-memebot-access": "workspace:^"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "koishi": "^4.18.7",
    "typescript": "^5.6.2",
    "vite": "^5.4.10",
    "vitest": "^3.2.4",
    "vue": "^3.5.12"
  }
}
