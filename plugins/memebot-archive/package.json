{
  "name": "koishi-plugin-memebot-archive",
  "version": "0.1.1-alpha.12",
  "description": "自用，月度报纸与作品归档插件",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "archive",
    "memebot"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
