{
  "name": "memebot-archive-payload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.5.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_BUILD=1 next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --config vitest.config.mts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "check:deploy": "node scripts/check-deploy.mjs",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "cross-env NODE_ENV=production yarn check:deploy && cross-env NODE_ENV=production yarn payload migrate",
    "preview": "yarn build && yarn start"
  },
  "dependencies": {
    "@faceless-ui/modal": "3.0.0",
    "@faceless-ui/scroll-info": "2.0.0",
    "@payloadcms/db-postgres": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/storage-s3": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "3.82.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  }
}
